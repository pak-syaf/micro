<script>
  // Narrative text popup: close on overlay click or Escape key
  const narrativeModal = document.getElementById('narrative-modal');
  if (narrativeModal) {
    narrativeModal.addEventListener('click', (e) => {
      if (e.target === narrativeModal) narrativeModal.classList.remove('open');
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') narrativeModal.classList.remove('open');
    });
  }

  // In-memory autosave (no localStorage — keeps all answers in JS state for this session).
  // Answers persist while the page/tab stays open, and are restored if inputs re-render,
  // but will NOT survive a page reload or new browser session. Remind students to print/
  // save as PDF before closing.
  const sessionAnswers = {};
  const inputs = document.querySelectorAll('.student-input');
  const confirmCheckbox = document.getElementById('step6-confirm');
  const statusEl = document.getElementById('save-status');
  let statusTimeout = null;

  inputs.forEach(input => {
    // Restore from in-memory state if present
    if (sessionAnswers[input.id] !== undefined) {
      input.value = sessionAnswers[input.id];
    }

    input.addEventListener('input', () => {
      sessionAnswers[input.id] = input.value;

      if (statusEl) {
        statusEl.textContent = '✓ Saved (this session)';
        statusEl.classList.add('visible');
        clearTimeout(statusTimeout);
        statusTimeout = setTimeout(() => {
          statusEl.classList.remove('visible');
        }, 1500);
      }
    });
  });

  // Confirmation checkbox (separate control, not a .student-input)
  if (confirmCheckbox) {
    confirmCheckbox.addEventListener('change', () => {
      sessionAnswers[confirmCheckbox.id] = confirmCheckbox.checked;
      if (statusEl) {
        statusEl.textContent = '✓ Saved (this session)';
        statusEl.classList.add('visible');
        clearTimeout(statusTimeout);
        statusTimeout = setTimeout(() => {
          statusEl.classList.remove('visible');
        }, 1500);
      }
    });
  }
</script>
